#!/usr/bin/env bash
# Firefox Omarchy Mode: keeps Firefox's browser chrome in sync with the active
# Omarchy theme (colors and optionally square corners) through userChrome.css.
#
#   firefox-omarchy-mode status                  print JSON status
#   firefox-omarchy-mode sync   [options]        re-apply if enabled, print status
#   firefox-omarchy-mode enable [options]        opt in, apply, print status
#   firefox-omarchy-mode disable                 undo everything, print status
#
# Options: --colors on|off  --corners square|rounded  --window-buttons show|hide
#          --tabs compact|default
#
# Every file this script touches carries the "omarchy-firefox-mode" marker, so
# disable removes exactly what enable added and leaves the rest of a user's
# userChrome.css and user.js alone.
set -euo pipefail

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
THEME_NAME_FILE="$HOME/.local/state/omarchy/current/theme.name"
FIREFOX_ROOTS=(
  "$HOME/.config/mozilla/firefox"
  "$HOME/.mozilla/firefox"
  "$HOME/.var/app/org.mozilla.firefox/config/mozilla/firefox"
  "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox"
)
MARK="omarchy-firefox-mode"
CSS_FILE="omarchy-mode.css"
IMPORT_LINE="@import url(\"$CSS_FILE\"); /* $MARK */"
PREF_LINE="user_pref(\"toolkit.legacyUserProfileCustomizations.stylesheets\", true); // $MARK"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$MARK"
ENABLED_FILE="$STATE_DIR/enabled"
OPTIONS_FILE="$STATE_DIR/options"
CHANGED_FILE="$STATE_DIR/last-change"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/$MARK.lock"

COLORS=on
CORNERS=square
WINDOW_BUTTONS=hide
TABS=compact

die() { echo "firefox-omarchy-mode: $*" >&2; exit 2; }

load_options() {
  [[ -f $OPTIONS_FILE ]] || return 0
  local key value
  while IFS='=' read -r key value; do
    case $key in
      colors) COLORS=$value ;;
      corners) CORNERS=$value ;;
      window-buttons) WINDOW_BUTTONS=$value ;;
      tabs) TABS=$value ;;
    esac
  done <"$OPTIONS_FILE"
}

parse_options() {
  while (($#)); do
    case $1 in
      --colors) COLORS=${2:-}; shift 2 ;;
      --corners) CORNERS=${2:-}; shift 2 ;;
      --window-buttons) WINDOW_BUTTONS=${2:-}; shift 2 ;;
      --tabs) TABS=${2:-}; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ $COLORS == on || $COLORS == off ]] || die "--colors must be on or off"
  [[ $CORNERS == square || $CORNERS == rounded ]] || die "--corners must be square or rounded"
  [[ $WINDOW_BUTTONS == show || $WINDOW_BUTTONS == hide ]] || die "--window-buttons must be show or hide"
  [[ $TABS == compact || $TABS == default ]] || die "--tabs must be compact or default"
}

save_options() {
  mkdir -p "$STATE_DIR"
  printf 'colors=%s\ncorners=%s\nwindow-buttons=%s\ntabs=%s\n' "$COLORS" "$CORNERS" "$WINDOW_BUTTONS" "$TABS" >"$OPTIONS_FILE"
}

# Every Firefox profile directory listed in any known profiles.ini.
profiles() {
  local root
  for root in "${FIREFOX_ROOTS[@]}"; do
    [[ -f $root/profiles.ini ]] || continue
    awk -F= -v root="$root" '
      function flush() {
        if (inprofile && path != "") print (relative == "1" ? root "/" path : path)
        path = ""; relative = "1"
      }
      /^\[/ { flush(); inprofile = ($0 ~ /^\[Profile/); next }
      inprofile && $1 == "Path" { path = substr($0, 6) }
      inprofile && $1 == "IsRelative" { relative = $2 }
      END { flush() }
    ' "$root/profiles.ini"
  done | while IFS= read -r dir; do
    [[ -d $dir ]] && readlink -f "$dir"
  done | sort -u
}

color() {
  local value
  value=$(sed -nE "s/^$1[[:space:]]*=[[:space:]]*\"([^\"]*)\".*/\1/p" "$THEME_DIR/colors.toml" 2>/dev/null | head -1)
  if [[ $value =~ ^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$ ]]; then echo "$value"; else echo "$2"; fi
}

render_css() {
  echo "/* Generated by Firefox Omarchy Mode ($MARK). Do not edit: it is rewritten on every theme change. */"

  if [[ $COLORS == on ]]; then
    local mode bg bg_dark fg accent selection muted
    mode=$(sed -nE 's/^mode[[:space:]]*=[[:space:]]*"?(light|dark)"?.*/\1/p' "$THEME_DIR/colors.toml" 2>/dev/null | head -1)
    bg=$(color background "#1e1e2e")
    bg_dark=$(color dark_background "$bg")
    fg=$(color foreground "#cdd6f4")
    accent=$(color accent "#89b4fa")
    selection=$(color selection "$accent")
    muted=$(color muted "$fg")

    cat <<CSS

/* Theme colors */
:root, :root * {
  --omarchy-bg: $bg;
  --omarchy-bg-dark: $bg_dark;
  --omarchy-fg: $fg;
  --omarchy-accent: $accent;
  --omarchy-selection: $selection;
  --omarchy-muted: $muted;

  --toolbox-background-color: var(--omarchy-bg-dark) !important;
  --toolbox-background-color-inactive: var(--omarchy-bg-dark) !important;
  --toolbox-text-color: var(--omarchy-fg) !important;
  --toolbox-text-color-inactive: color-mix(in srgb, var(--omarchy-fg) 70%, var(--omarchy-bg-dark)) !important;
  --lwt-accent-color: var(--omarchy-bg-dark) !important;
  --lwt-accent-color-inactive: var(--omarchy-bg-dark) !important;

  --toolbar-background-color: var(--omarchy-bg) !important;
  --toolbar-text-color: var(--omarchy-fg) !important;
  --toolbarbutton-icon-fill: var(--omarchy-fg) !important;
  --toolbarbutton-background-color-hover: color-mix(in srgb, var(--omarchy-fg) 10%, transparent) !important;
  --toolbarbutton-background-color-active: color-mix(in srgb, var(--omarchy-fg) 16%, transparent) !important;

  --tab-background-color-selected: var(--omarchy-bg) !important;
  --tab-selected-textcolor: var(--omarchy-fg) !important;
  --tab-selected-outline-color: transparent !important;
  --tab-loading-fill: var(--omarchy-accent) !important;

  --toolbar-field-background-color: color-mix(in srgb, var(--omarchy-fg) 6%, var(--omarchy-bg)) !important;
  --toolbar-field-text-color: var(--omarchy-fg) !important;
  --toolbar-field-border-color: transparent !important;
  --toolbar-field-background-color-focus: var(--omarchy-bg) !important;
  --toolbar-field-text-color-focus: var(--omarchy-fg) !important;
  --toolbar-field-border-color-focus: var(--omarchy-accent) !important;

  --urlbarview-background-color-selected: var(--omarchy-selection) !important;
  --urlbarview-text-color-selected: var(--omarchy-fg) !important;
  --urlbarview-background-color-hover: color-mix(in srgb, var(--omarchy-fg) 8%, var(--omarchy-bg)) !important;
  --urlbarview-separator-color: var(--omarchy-muted) !important;
  --urlbarview-text-color-secondary: color-mix(in srgb, var(--omarchy-fg) 65%, var(--omarchy-bg)) !important;

  --panel-background-color: var(--omarchy-bg) !important;
  --panel-text-color: var(--omarchy-fg) !important;
  --panel-border-color: var(--omarchy-muted) !important;
  --background-color-box: var(--omarchy-bg) !important;
  --text-color: var(--omarchy-fg) !important;

  --sidebar-background-color: var(--omarchy-bg-dark) !important;
  --sidebar-text-color: var(--omarchy-fg) !important;
  --sidebar-border-color: var(--omarchy-muted) !important;

  --chrome-content-separator-color: var(--omarchy-bg-dark) !important;
  --tabpanel-background-color: var(--omarchy-bg) !important;

  --focus-outline-color: var(--omarchy-accent) !important;
  --color-accent-primary: var(--omarchy-accent) !important;
  --color-accent-primary-hover: color-mix(in srgb, var(--omarchy-accent) 85%, var(--omarchy-fg)) !important;
  --color-accent-primary-active: color-mix(in srgb, var(--omarchy-accent) 70%, var(--omarchy-fg)) !important;
  --button-text-color-primary: var(--omarchy-bg) !important;
}
CSS
    [[ -n $mode ]] && printf '\n:root {\n  color-scheme: %s !important;\n}\n' "$mode"
    cat <<'CSS'

#navigator-toolbox {
  background-color: var(--omarchy-bg-dark) !important;
}

.tabbrowser-tab[selected] .tab-background {
  background-color: var(--omarchy-bg) !important;
  box-shadow: none !important;
}

.tabbrowser-tab:hover:not([selected]) .tab-background {
  background-color: color-mix(in srgb, var(--omarchy-fg) 8%, var(--omarchy-bg-dark)) !important;
}
CSS
  fi

  if [[ $CORNERS == square ]]; then
    cat <<'CSS'

/* Square corners */
:root, :root * {
  --border-radius-small: 0 !important;
  --border-radius-medium: 0 !important;
  --border-radius-large: 0 !important;
  --border-radius-xlarge: 0 !important;
  --button-border-radius: 0 !important;
  --toolbarbutton-border-radius: 0 !important;
  --tab-border-radius: 0 !important;
  --urlbar-border-radius: 0 !important;
  --urlbarview-border-radius: 0 !important;
  --urlbar-background-border-radius: 0 !important;
  --urlbar-inner-border-radius: 0 !important;
  --popup-border-radius: 0 !important;
  --panel-border-radius: 0 !important;
  --panel-menuitem-border-radius: 0 !important;
  --menuitem-border-radius: 0 !important;
  --panel-list-border-radius: 0 !important;
  --card-border-radius: 0 !important;
  --chip-border-radius: 0 !important;
  --chrome-block-radius: 0 !important;
}

.tab-background,
#urlbar-background,
.urlbar-background,
#searchbar,
.toolbarbutton-1 > .toolbarbutton-icon,
.toolbarbutton-1 > .toolbarbutton-badge-stack,
.toolbarbutton-1 > .toolbarbutton-text,
.urlbar-page-action,
.urlbarView-row,
.urlbarView-row-inner,
menupopup,
panel {
  border-radius: 0 !important;
}
CSS
  fi
}

render_window_buttons_css() {
  [[ $WINDOW_BUTTONS == hide ]] || return 0
  cat <<'CSS'

/* Hide the window buttons (close, minimize, maximize) in the tab strip */
.titlebar-buttonbox-container {
  display: none !important;
}
CSS
}

render_tabs_css() {
  [[ $TABS == compact ]] || return 0
  cat <<'CSS'

/* Compact tabs: 1px above and below each tab in the horizontal tab strip */
#TabsToolbar, #TabsToolbar * {
  --tab-margin-block: 1px !important;
}
CSS
}

# Replace file $1 with stdin only when the content differs; returns 0 on a change.
write_if_changed() {
  local tmp
  tmp=$(mktemp "$1.XXXXXX")
  cat >"$tmp"
  if [[ -f $1 ]] && cmp -s "$tmp" "$1"; then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$1"
}

install_profile() {
  local profile=$1 changed=1 user_chrome="$1/chrome/userChrome.css" user_js="$1/user.js"
  mkdir -p "$profile/chrome"

  { render_css; render_window_buttons_css; render_tabs_css; } | write_if_changed "$profile/chrome/$CSS_FILE" && changed=0

  # @import only works before every other rule, so it goes on the first line.
  if ! grep -qF "$MARK" "$user_chrome" 2>/dev/null; then
    { echo "$IMPORT_LINE"; cat "$user_chrome" 2>/dev/null || true; } | write_if_changed "$user_chrome" && changed=0
  fi

  if ! grep -qF "$MARK" "$user_js" 2>/dev/null; then
    echo "$PREF_LINE" >>"$user_js"
    changed=0
  fi

  return $changed
}

# Drop our marked lines; delete the file if nothing else is left in it.
strip_marked() {
  [[ -f $1 ]] || return 1
  grep -qF "$MARK" "$1" || return 1
  grep -vF "$MARK" "$1" | write_if_changed "$1" || true
  grep -q '[^[:space:]]' "$1" || rm -f "$1"
}

uninstall_profile() {
  local profile=$1 changed=1
  [[ -f $profile/chrome/$CSS_FILE ]] && rm -f "$profile/chrome/$CSS_FILE" && changed=0
  strip_marked "$profile/chrome/userChrome.css" && changed=0
  strip_marked "$profile/user.js" && changed=0
  rmdir "$profile/chrome" 2>/dev/null || true
  return $changed
}

profile_installed() {
  [[ -f $1/chrome/$CSS_FILE ]] && grep -qF "$MARK" "$1/chrome/userChrome.css" 2>/dev/null && grep -qF "$MARK" "$1/user.js" 2>/dev/null
}

mark_changed() {
  mkdir -p "$STATE_DIR"
  date +%s >"$CHANGED_FILE"
}

apply_all() {
  local profile changed=1
  while IFS= read -r profile; do
    install_profile "$profile" && changed=0
  done < <(profiles)
  ((changed == 0)) && mark_changed
  return 0
}

status() {
  local enabled=false running=false restart=false pid started=0 last=0 theme="Unknown" profile
  local -a entries=()

  [[ -f $ENABLED_FILE ]] && enabled=true
  [[ -f $THEME_NAME_FILE ]] && theme=$(sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g' "$THEME_NAME_FILE")

  if pid=$(pgrep -o -x firefox 2>/dev/null); then
    running=true
    started=$(date -d "$(ps -o lstart= -p "$pid")" +%s 2>/dev/null || echo 0)
    [[ -f $CHANGED_FILE ]] && last=$(<"$CHANGED_FILE")
    ((last > started)) && restart=true
  fi

  while IFS= read -r profile; do
    local installed=false
    profile_installed "$profile" && installed=true
    entries+=("$(jq -cn --arg path "$profile" --argjson installed "$installed" \
      '{name: ($path | split("/") | last), path: $path, installed: $installed}')")
  done < <(profiles)

  printf '%s\n' "${entries[@]}" | jq -cs \
    --argjson enabled "$enabled" --argjson running "$running" --argjson restart "$restart" \
    --arg theme "$theme" --arg colors "$COLORS" --arg corners "$CORNERS" --arg buttons "$WINDOW_BUTTONS" --arg tabs "$TABS" '
    {
      enabled: $enabled,
      theme: $theme,
      colors: ($colors == "on"),
      squareCorners: ($corners == "square"),
      hideWindowButtons: ($buttons == "hide"),
      compactTabs: ($tabs == "compact"),
      firefoxRunning: $running,
      restartNeeded: $restart,
      profiles: .,
      active: ($enabled and length > 0 and all(.[]; .installed) and ($restart | not))
    }'
}

command=${1:-status}
shift || true

exec 9>"$LOCK_FILE"
flock 9

load_options
case $command in
  status)
    parse_options "$@"
    status
    ;;
  sync)
    parse_options "$@"
    if [[ -f $ENABLED_FILE ]]; then
      save_options
      apply_all
    fi
    status
    ;;
  enable)
    parse_options "$@"
    save_options
    touch "$ENABLED_FILE"
    apply_all
    status
    ;;
  disable)
    changed=1
    while IFS= read -r profile; do
      uninstall_profile "$profile" && changed=0
    done < <(profiles)
    rm -f "$ENABLED_FILE"
    ((changed == 0)) && mark_changed
    status
    ;;
  *)
    die "usage: firefox-omarchy-mode status|sync|enable|disable [--colors on|off] [--corners square|rounded] [--window-buttons show|hide] [--tabs compact|default]"
    ;;
esac
